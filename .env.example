ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-sonnet-4-6
DATA_DIR=./data/projects
CORS_ORIGINS=
# Optional — enable Confluence import (Data Center PAT, Bearer auth):
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=
# Optional — test stand DB for one-click SQL artifact execution from test cases:
TEST_DB_URL=
# Optional — test stand base URL for one-click curl artifact execution
# (requests go to TEST_STAND_URL/<service-name><path>):
TEST_STAND_URL=
# Optional — export bug reports as Jira issues (Data Center PAT, Bearer auth;
# a Jira token, not the Confluence one). All bugs go to one project:
JIRA_BASE_URL=
JIRA_PAT=
JIRA_PROJECT_KEY=MTSPAY
JIRA_ISSUE_TYPE=Bug
# Required MTSPAY custom fields (empty = omit on create):
JIRA_BUG_TYPE=Feature testing
JIRA_SYSTEM=UMP
JIRA_TEAM=Flex core
# Optional per-team fields (empty = omit on create):
JIRA_DEVELOPER=
JIRA_FIX_VERSION=
# Agile board whose active sprint is set on new bugs (0 = off):
JIRA_BOARD_ID=1880
# Bug fixer — headless Claude Code runs that fix exported bugs in service repos.
# Token from `claude setup-token` (subscription auth); empty = feature off.
CLAUDE_CODE_OAUTH_TOKEN=
# Anthropic API is reached through a local SSH tunnel (ssh -fN claude-proxy):
CLAUDE_PROXY=http://127.0.0.1:8888
CLAUDE_PROXY_SSH_HOST=claude-proxy
# Colon-separated roots where service repos live (dir name == service name):
REPOS_DIRS=~/IdeaProjects:~/IdeaProjects/flp
BUG_FIXER_AUTO=true
BUG_FIX_TIMEOUT_SECONDS=3600
# Autotest generator — headless Claude Code runs that turn accepted test cases
# into Java autotests (shares the Claude Code auth/proxy/timeout settings above).
# Path to the flp-autotests git repo; empty = feature off.
AUTOTESTS_REPO_DIR=~/IdeaProjects/flp/flp-autotests
AUTOTEST_AUTO=true
