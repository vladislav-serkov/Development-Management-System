# All AI workflows use the local Codex SDK and saved ChatGPT login (codex login).
# Empty workflow overrides use CODEX_MODEL, then the account catalog default.
EXTRACTION_MODEL=
TEST_CASES_MODEL=
BUGS_MODEL=
STRUCTURED_TIMEOUT_SECONDS=1200
STRUCTURED_LOG_DIR=logs/structured
EXTRACTION_EFFORT=high
# Host PostgreSQL; Compose overrides this to its db service.
# Use a separate database (e.g. extract_agent_dev) for development beside production.
DATABASE_URL=postgresql+asyncpg://extract:extract@localhost:5432/extract_agent
CORS_ORIGINS=
# Local login is off; scripts/serve.sh enables it for the published instance.
# For Docker production set AUTH_ENABLED=true and COOKIE_SECURE=true.
AUTH_ENABLED=false
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
FRONTEND_DIST=frontend/dist
# Optional — enable Confluence import (Data Center PAT, Bearer auth):
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=
# Optional — test stand DB for one-click SQL artifact execution from test cases:
TEST_DB_URL=
# Optional — test stand base URL for one-click curl artifact execution
# (requests go to TEST_STAND_URL/<service-name><path>):
TEST_STAND_URL=
# Optional — WireMock base URL for one-click test-case mock upload.
# Include the gateway prefix, omit /__admin/mappings:
# TEST_WIREMOCK_URL=http://services-ump2-test.mbrd.ru:8090/bnpl-wiremock
TEST_WIREMOCK_URL=
# Optional — export bug reports as Jira issues (Data Center PAT, Bearer auth;
# a Jira token, not the Confluence one). All bugs go to one project:
JIRA_BASE_URL=
JIRA_PAT=
JIRA_PROJECT_KEY=MTSPAY
JIRA_ISSUE_TYPE=Bug
# Required MTSPAY custom fields (empty = omit on create):
JIRA_BUG_TYPE=Feature testing
JIRA_SYSTEM=UMP
JIRA_TEAM=Flex core
# Optional per-team fields (empty = omit on create):
JIRA_DEVELOPER=
JIRA_FIX_VERSION=
# Agile board whose active sprint is set on new bugs (0 = off):
JIRA_BOARD_ID=1880
# Personal local Codex SDK jobs: run `codex login` with ChatGPT on this host.
# Uses the saved account; no API key or copied subscription token is needed.
CODEX_ENABLED=true
# Empty = default model from the account catalog and the SDK's bundled runtime.
CODEX_MODEL=
CODEX_CLI=
# Colon-separated roots where service repos live (dir name == service name):
REPOS_DIRS=~/IdeaProjects:~/IdeaProjects/flp
BUG_FIXER_AUTO=true
BUG_FIX_TIMEOUT_SECONDS=3600
BUG_FIX_LOG_DIR=logs/bug-fixer
# ru-dsl script generator — local Codex SDK jobs that turn accepted test cases
# («Принять») into Russian Gherkin scenarios in the ru-dsl-v2 repo and open an MR
# (shares the Codex login/timeout settings above).
# Path to a ru-dsl-v2 git clone the jobs may switch branches in; empty = feature off.
RU_DSL_REPO_DIR=
DSL_SCRIPT_AUTO=true
DSL_SCRIPT_LOG_DIR=logs/dsl-script
# After a scenario is written the backend runs it on the test stand and shows the
# step-by-step result on the case (needs TEST_DB_URL below; false = only write).
DSL_SCRIPT_RUN=true
# Runner profile the scenarios are written for and run with
# (src/test/resources/config/application-<name>.properties in ru-dsl-v2).
DSL_SCRIPT_PROFILE=bnpl-ump2-test
DSL_SCRIPT_RUN_TIMEOUT_SECONDS=600
# Kafka bootstrap of the test stand for scenarios that publish/read events
# (empty = such scenarios are not run). Scenario mocks use TEST_WIREMOCK_URL.
TEST_KAFKA_BOOTSTRAP=
# Feature implementation shares Codex login, repo roots, and timeout.
IMPLEMENT_LOG_DIR=logs/implement

# Business gap analysis — read-only Codex job, same ChatGPT login/model as above.
# Private run directories contain original source snapshots and streamed events.
GAPS_LOG_DIR=logs/gaps
GAPS_TIMEOUT_SECONDS=1200
GAPS_MAX_SOURCES=30

# Test-case assistant — read-only Codex analyst; the backend runs its stand actions
# (SQL in TEST_DB_URL, HTTP to TEST_STAND_URL, mocks in TEST_WIREMOCK_URL) itself.
# It writes only into the schemas the feature already uses (service schema + schemas of its
# cases' SQL). Rounds = answers that may ask for actions.
ASSISTANT_LOG_DIR=logs/assistant
ASSISTANT_TIMEOUT_SECONDS=1200
ASSISTANT_MAX_ROUNDS=10
