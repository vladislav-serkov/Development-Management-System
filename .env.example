ANTHROPIC_API_KEY=sk-ant-xxx
# Defaults mirror app/config.py. These are app models, independent of the coding agent.
CLAUDE_MODEL=claude-sonnet-5-5
GAPS_MODEL=claude-sonnet-5-5
TEST_CASES_MODEL=claude-sonnet-5-5
BUGS_MODEL=claude-sonnet-5-5
EXTRACTION_MAX_TOKENS=32000
EXTRACTION_EFFORT=high
# Host PostgreSQL; Compose overrides this to its db service.
# Use a separate database (e.g. extract_agent_dev) for development beside production.
DATABASE_URL=postgresql+asyncpg://extract:extract@localhost:5432/extract_agent
CORS_ORIGINS=
# Local login is off; scripts/serve.sh enables it for the published instance.
# For Docker production set AUTH_ENABLED=true and COOKIE_SECURE=true.
AUTH_ENABLED=false
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
FRONTEND_DIST=frontend/dist
# Optional — enable Confluence import (Data Center PAT, Bearer auth):
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=
# Optional — test stand DB for one-click SQL artifact execution from test cases:
TEST_DB_URL=
# Optional — test stand base URL for one-click curl artifact execution
# (requests go to TEST_STAND_URL/<service-name><path>):
TEST_STAND_URL=
# Optional — export bug reports as Jira issues (Data Center PAT, Bearer auth;
# a Jira token, not the Confluence one). All bugs go to one project:
JIRA_BASE_URL=
JIRA_PAT=
JIRA_PROJECT_KEY=MTSPAY
JIRA_ISSUE_TYPE=Bug
# Required MTSPAY custom fields (empty = omit on create):
JIRA_BUG_TYPE=Feature testing
JIRA_SYSTEM=UMP
JIRA_TEAM=Flex core
# Optional per-team fields (empty = omit on create):
JIRA_DEVELOPER=
JIRA_FIX_VERSION=
# Agile board whose active sprint is set on new bugs (0 = off):
JIRA_BOARD_ID=1880
# Personal local Codex SDK jobs: run `codex login` with ChatGPT on this host.
# Uses the saved account; no API key or copied subscription token is needed.
CODEX_ENABLED=true
# Empty = default model from the account catalog and the SDK's bundled runtime.
CODEX_MODEL=
CODEX_CLI=
# Colon-separated roots where service repos live (dir name == service name):
REPOS_DIRS=~/IdeaProjects:~/IdeaProjects/flp
BUG_FIXER_AUTO=true
BUG_FIX_TIMEOUT_SECONDS=3600
BUG_FIX_LOG_DIR=logs/bug-fixer
# Autotest generator — local Codex SDK jobs that turn accepted test cases
# into Java autotests (shares the Codex login/timeout settings above).
# Path to the flp-autotests git repo; empty = feature off.
AUTOTESTS_REPO_DIR=
AUTOTEST_AUTO=true
AUTOTEST_LOG_DIR=logs/autotest-gen
# Feature implementation shares Codex login, repo roots, and timeout.
IMPLEMENT_LOG_DIR=logs/implement
